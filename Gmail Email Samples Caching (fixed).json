    {
      "parameters": {
        "jsCode": "// Normalize every Gmail item to the SAME fixed set of keys so Supabase's\n// bulk insert (PostgREST) doesn't throw PGRST102 \"All object keys must match\".\n// Missing keys (e.g. Cc on messages with no CC) are filled with null, and any\n// extra keys Gmail returns that have no column are dropped.\nconst COLUMNS = [\n  'id',\n  'threadId',\n  'snippet',\n  'payload',\n  'sizeEstimate',\n  'historyId',\n  'internalDate',\n  'labels',\n  'Subject',\n  'From',\n  'To',\n  'Cc'\n];\n\nreturn items.map((item) => {\n  const src = item.json || {};\n  const out = {};\n  for (const key of COLUMNS) {\n    out[key] = src[key] === undefined ? null : src[key];\n  }\n  return { json: out };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        272
      ],
      "id": "b1c2d3e4-f5a6-4b7c-8d9e-0a1b2c3d4e5f",
      "name": "Normalize keys"
    },
